# 이 파일을 .env 로 복사한 뒤 값을 채워주세요. (.env 는 git에 커밋하지 않습니다)
PORT=5678

# ── MongoDB ──
# docker-compose 에 함께 뜨는 MongoDB 관리자 계정 (deploy.sh 가 비밀번호 자동 생성)
# 처음 DB 볼륨을 만들 때만 적용되므로, 이후에 바꾸면 DB 쪽 비밀번호도 직접 바꿔야 합니다
MONGO_INITDB_ROOT_USERNAME=admin
MONGO_INITDB_ROOT_PASSWORD=
# (선택) DB 이름, 기본 loc
# MONGO_DB=loc

# (선택) 외부 MongoDB 를 쓰려면 접속 문자열을 지정 (지정하면 위 내장 DB 설정 대신 사용)
# 비밀번호의 특수문자는 URL 인코딩: ! -> %21
# MONGO_URI=mongodb://아이디:비밀번호@호스트:포트/loc?authSource=admin

# 로그인 토큰 서명용 비밀키 (openssl rand -hex 32 로 생성, deploy.sh 가 자동 생성)
AUTH_SECRET=

# ── 로그인 방식: 아래 두 가지 중 하나 이상 설정 ──
# 1) 비밀번호 로그인 (비우면 비활성화)
ADMIN_PASSWORD=change-me

# 2) 구글 로그인: Google Cloud Console 에서 만든 OAuth 클라이언트 ID (README 참고)
# GOOGLE_CLIENT_ID=1234567890-xxxx.apps.googleusercontent.com
# 항상 로그인을 허용할 관리자 구글 계정 (쉼표 구분). 나머지는 관리 화면 '사용자'에서 추가
# ADMIN_EMAILS=me@gmail.com

# (권장) 공유 링크 미리보기(카카오톡 등)에 쓸 서비스 주소. 비우면 요청 헤더로 추정
PUBLIC_URL=https://location.sideplay.dev

# (선택) 로그인 유지 시간(시간), 기본 168
# AUTH_TTL_HOURS=168

# (선택) 다른 도메인에서 API를 호출하는 경우 허용할 origin (쉼표 구분)
# CORS_ORIGINS=http://localhost:5173

# (선택) 이 시간 동안 위치 갱신이 없으면 운행 자동 종료, 기본 12
# STALE_DRIVE_HOURS=12

# (선택) 운행 종료 후 공유 링크 유효 시간, 기본 24
# SHARE_EXPIRE_HOURS=24
