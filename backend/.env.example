# 이 파일을 .env 로 복사한 뒤 값을 채워주세요. (.env 는 git에 커밋하지 않습니다)
PORT=5678

# MongoDB 접속 문자열 (비밀번호의 특수문자는 URL 인코딩: ! -> %21)
MONGO_URI=mongodb://USER:PASSWORD@HOST:PORT/?authSource=admin

# 관리자/운전자 로그인 비밀번호
ADMIN_PASSWORD=change-me

# 로그인 토큰 서명용 비밀키 (openssl rand -hex 32 로 생성)
AUTH_SECRET=

# (선택) 로그인 유지 시간(시간), 기본 168
# AUTH_TTL_HOURS=168

# (선택) 다른 도메인에서 API를 호출하는 경우 허용할 origin (쉼표 구분)
# CORS_ORIGINS=http://localhost:5173

# (선택) 이 시간 동안 위치 갱신이 없으면 운행 자동 종료, 기본 12
# STALE_DRIVE_HOURS=12

# (선택) 운행 종료 후 공유 링크 유효 시간, 기본 24
# SHARE_EXPIRE_HOURS=24
